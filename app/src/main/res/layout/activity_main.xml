<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- 侧滑时内容右移露出的底层：暗色遮罩 + 返回箭头（位于内容之下） -->
    <View
        android:id="@+id/swipeScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#CC000000" />

    <ImageView
        android:id="@+id/swipeArrow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:alpha="0"
        android:background="@drawable/swipe_arrow_circle"
        android:contentDescription="@string/menu_refresh"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back" />

    <!-- 开屏品牌页：系统 Splash 交棒后显示，最短停留后淡出 -->
    <LinearLayout
        android:id="@+id/splashBrand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="@string/splash_title"
            android:textColor="@color/brand_blue_dark"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/app_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!--
        网页容器。顶栏展开时整体下推一个顶栏高度（translationY），
        网页顶部不会被顶栏挡住；顶栏收起时位移归零，不触发网页回流。
        底部 margin 由 inset 监听设置，避开三键导航 / 手势条。
    -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        边缘手势热区：仅 26dp 宽，覆盖在网页之上、顶栏 / 配置页 / 错误页之下。
        从屏幕左缘按下并右滑即触发"后退 / 退出"手势。
    -->
    <View
        android:id="@+id/edgeSwipeZone"
        android:layout_width="26dp"
        android:layout_height="match_parent" />

    <!--
        顶栏：固定显示，覆盖在网页之上，不随滚动收起。
        顶部 padding 由 inset 监听设置为状态栏高度，背景延伸到状态栏后面，
        工具栏内容永远在状态栏下方，绝不与手机原有顶栏重叠。
        刻意不设 elevation：避免盖到配置页 / 错误页之上。
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_topbar_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/app_topbar_bg"
            android:minHeight="0dp"
            android:theme="@style/ThemeOverlay.Solarpanel.Toolbar"
            app:menu="@menu/main_menu"
            app:subtitleTextAppearance="@style/TextAppearance.Solarpanel.ToolbarSubtitle"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.Solarpanel.ToolbarTitle"
            app:titleMarginTop="0dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="@color/brand_blue"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/app_topbar_divider" />

    </LinearLayout>

    <!-- 首次配置 / 修改地址 -->
    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="48dp"
            android:paddingRight="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_title"
                android:textAppearance="@style/TextAppearance.Solarpanel.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/setup_subtitle"
                android:textAppearance="@style/TextAppearance.Solarpanel.Body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/serverInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:helperText="@string/setup_helper"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/serverInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/setup_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/setup_button"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

    <!-- 错误页 -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.55"
            android:contentDescription="@string/err_title"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/err_title"
            android:textAppearance="@style/TextAppearance.Solarpanel.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/err_detail"
            android:textAppearance="@style/TextAppearance.Solarpanel.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="160dp"
            android:text="@string/err_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorChangeButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/err_change" />

    </LinearLayout>

</FrameLayout>
